# Firebase Configuration
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional for SEO artifact builds.
# Use one of these so scripts/generate-seo-artifacts.js can merge live Firebase
# storefront fields without writing them into product-seo-index.json.
FIREBASE_SERVICE_ACCOUNT_PATH=C:/path/to/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
