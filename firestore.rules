rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email in ['sshibinthomass@gmail.com', 'rosaryplanthouse@gmail.com'];
    }

    function isValidCheckoutAttemptCustomer(customer) {
      return customer is map
             && customer.keys().hasOnly(['name', 'email', 'phone', 'phoneSearch'])
             && customer.keys().hasAll(['name', 'email', 'phone', 'phoneSearch'])
             && customer.name is string
             && customer.name.size() <= 200
             && customer.email is string
             && customer.email.size() <= 320
             && customer.phone is string
             && customer.phone.size() <= 32
             && customer.phoneSearch is string
             && customer.phoneSearch.size() <= 32;
    }

    function isValidCheckoutAttemptDelivery(delivery) {
      return delivery is map
             && delivery.keys().hasOnly([
               'name', 'phone', 'whatsapp', 'address', 'pincode', 'district', 'state'
             ])
             && delivery.keys().hasAll([
               'name', 'phone', 'whatsapp', 'address', 'pincode', 'district', 'state'
             ])
             && delivery.name is string
             && delivery.name.size() <= 200
             && delivery.phone is string
             && delivery.phone.size() <= 32
             && delivery.whatsapp is string
             && delivery.whatsapp.size() <= 32
             && delivery.address is string
             && delivery.address.size() <= 1000
             && delivery.pincode is string
             && delivery.pincode.size() <= 20
             && delivery.district is string
             && delivery.district.size() <= 120
             && delivery.state is string
             && delivery.state.size() <= 120;
    }

    function isValidCheckoutAttemptItems(items) {
      return items is list
             && items.size() <= 20
             && (items.size() <= 0 || (
               items[0] is map
               && items[0].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[0].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[0].productId is string
               && items[0].productId.size() <= 128
               && items[0].name is string
               && items[0].name.size() <= 300
               && items[0].price is number
               && items[0].price >= 0
               && items[0].price <= 1000000000
               && items[0].quantity is number
               && items[0].quantity >= 0
               && items[0].quantity <= 1000000
             ))
             && (items.size() <= 1 || (
               items[1] is map
               && items[1].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[1].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[1].productId is string
               && items[1].productId.size() <= 128
               && items[1].name is string
               && items[1].name.size() <= 300
               && items[1].price is number
               && items[1].price >= 0
               && items[1].price <= 1000000000
               && items[1].quantity is number
               && items[1].quantity >= 0
               && items[1].quantity <= 1000000
             ))
             && (items.size() <= 2 || (
               items[2] is map
               && items[2].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[2].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[2].productId is string
               && items[2].productId.size() <= 128
               && items[2].name is string
               && items[2].name.size() <= 300
               && items[2].price is number
               && items[2].price >= 0
               && items[2].price <= 1000000000
               && items[2].quantity is number
               && items[2].quantity >= 0
               && items[2].quantity <= 1000000
             ))
             && (items.size() <= 3 || (
               items[3] is map
               && items[3].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[3].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[3].productId is string
               && items[3].productId.size() <= 128
               && items[3].name is string
               && items[3].name.size() <= 300
               && items[3].price is number
               && items[3].price >= 0
               && items[3].price <= 1000000000
               && items[3].quantity is number
               && items[3].quantity >= 0
               && items[3].quantity <= 1000000
             ))
             && (items.size() <= 4 || (
               items[4] is map
               && items[4].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[4].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[4].productId is string
               && items[4].productId.size() <= 128
               && items[4].name is string
               && items[4].name.size() <= 300
               && items[4].price is number
               && items[4].price >= 0
               && items[4].price <= 1000000000
               && items[4].quantity is number
               && items[4].quantity >= 0
               && items[4].quantity <= 1000000
             ))
             && (items.size() <= 5 || (
               items[5] is map
               && items[5].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[5].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[5].productId is string
               && items[5].productId.size() <= 128
               && items[5].name is string
               && items[5].name.size() <= 300
               && items[5].price is number
               && items[5].price >= 0
               && items[5].price <= 1000000000
               && items[5].quantity is number
               && items[5].quantity >= 0
               && items[5].quantity <= 1000000
             ))
             && (items.size() <= 6 || (
               items[6] is map
               && items[6].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[6].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[6].productId is string
               && items[6].productId.size() <= 128
               && items[6].name is string
               && items[6].name.size() <= 300
               && items[6].price is number
               && items[6].price >= 0
               && items[6].price <= 1000000000
               && items[6].quantity is number
               && items[6].quantity >= 0
               && items[6].quantity <= 1000000
             ))
             && (items.size() <= 7 || (
               items[7] is map
               && items[7].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[7].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[7].productId is string
               && items[7].productId.size() <= 128
               && items[7].name is string
               && items[7].name.size() <= 300
               && items[7].price is number
               && items[7].price >= 0
               && items[7].price <= 1000000000
               && items[7].quantity is number
               && items[7].quantity >= 0
               && items[7].quantity <= 1000000
             ))
             && (items.size() <= 8 || (
               items[8] is map
               && items[8].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[8].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[8].productId is string
               && items[8].productId.size() <= 128
               && items[8].name is string
               && items[8].name.size() <= 300
               && items[8].price is number
               && items[8].price >= 0
               && items[8].price <= 1000000000
               && items[8].quantity is number
               && items[8].quantity >= 0
               && items[8].quantity <= 1000000
             ))
             && (items.size() <= 9 || (
               items[9] is map
               && items[9].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[9].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[9].productId is string
               && items[9].productId.size() <= 128
               && items[9].name is string
               && items[9].name.size() <= 300
               && items[9].price is number
               && items[9].price >= 0
               && items[9].price <= 1000000000
               && items[9].quantity is number
               && items[9].quantity >= 0
               && items[9].quantity <= 1000000
             ))
             && (items.size() <= 10 || (
               items[10] is map
               && items[10].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[10].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[10].productId is string
               && items[10].productId.size() <= 128
               && items[10].name is string
               && items[10].name.size() <= 300
               && items[10].price is number
               && items[10].price >= 0
               && items[10].price <= 1000000000
               && items[10].quantity is number
               && items[10].quantity >= 0
               && items[10].quantity <= 1000000
             ))
             && (items.size() <= 11 || (
               items[11] is map
               && items[11].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[11].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[11].productId is string
               && items[11].productId.size() <= 128
               && items[11].name is string
               && items[11].name.size() <= 300
               && items[11].price is number
               && items[11].price >= 0
               && items[11].price <= 1000000000
               && items[11].quantity is number
               && items[11].quantity >= 0
               && items[11].quantity <= 1000000
             ))
             && (items.size() <= 12 || (
               items[12] is map
               && items[12].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[12].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[12].productId is string
               && items[12].productId.size() <= 128
               && items[12].name is string
               && items[12].name.size() <= 300
               && items[12].price is number
               && items[12].price >= 0
               && items[12].price <= 1000000000
               && items[12].quantity is number
               && items[12].quantity >= 0
               && items[12].quantity <= 1000000
             ))
             && (items.size() <= 13 || (
               items[13] is map
               && items[13].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[13].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[13].productId is string
               && items[13].productId.size() <= 128
               && items[13].name is string
               && items[13].name.size() <= 300
               && items[13].price is number
               && items[13].price >= 0
               && items[13].price <= 1000000000
               && items[13].quantity is number
               && items[13].quantity >= 0
               && items[13].quantity <= 1000000
             ))
             && (items.size() <= 14 || (
               items[14] is map
               && items[14].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[14].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[14].productId is string
               && items[14].productId.size() <= 128
               && items[14].name is string
               && items[14].name.size() <= 300
               && items[14].price is number
               && items[14].price >= 0
               && items[14].price <= 1000000000
               && items[14].quantity is number
               && items[14].quantity >= 0
               && items[14].quantity <= 1000000
             ))
             && (items.size() <= 15 || (
               items[15] is map
               && items[15].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[15].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[15].productId is string
               && items[15].productId.size() <= 128
               && items[15].name is string
               && items[15].name.size() <= 300
               && items[15].price is number
               && items[15].price >= 0
               && items[15].price <= 1000000000
               && items[15].quantity is number
               && items[15].quantity >= 0
               && items[15].quantity <= 1000000
             ))
             && (items.size() <= 16 || (
               items[16] is map
               && items[16].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[16].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[16].productId is string
               && items[16].productId.size() <= 128
               && items[16].name is string
               && items[16].name.size() <= 300
               && items[16].price is number
               && items[16].price >= 0
               && items[16].price <= 1000000000
               && items[16].quantity is number
               && items[16].quantity >= 0
               && items[16].quantity <= 1000000
             ))
             && (items.size() <= 17 || (
               items[17] is map
               && items[17].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[17].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[17].productId is string
               && items[17].productId.size() <= 128
               && items[17].name is string
               && items[17].name.size() <= 300
               && items[17].price is number
               && items[17].price >= 0
               && items[17].price <= 1000000000
               && items[17].quantity is number
               && items[17].quantity >= 0
               && items[17].quantity <= 1000000
             ))
             && (items.size() <= 18 || (
               items[18] is map
               && items[18].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[18].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[18].productId is string
               && items[18].productId.size() <= 128
               && items[18].name is string
               && items[18].name.size() <= 300
               && items[18].price is number
               && items[18].price >= 0
               && items[18].price <= 1000000000
               && items[18].quantity is number
               && items[18].quantity >= 0
               && items[18].quantity <= 1000000
             ))
             && (items.size() <= 19 || (
               items[19] is map
               && items[19].keys().hasOnly(['productId', 'name', 'price', 'quantity'])
               && items[19].keys().hasAll(['productId', 'name', 'price', 'quantity'])
               && items[19].productId is string
               && items[19].productId.size() <= 128
               && items[19].name is string
               && items[19].name.size() <= 300
               && items[19].price is number
               && items[19].price >= 0
               && items[19].price <= 1000000000
               && items[19].quantity is number
               && items[19].quantity >= 0
               && items[19].quantity <= 1000000
             ));
    }

    function isValidCheckoutAttemptError(error) {
      return error is map
             && error.keys().hasOnly(['category', 'code', 'message'])
             && error.keys().hasAll(['category', 'code', 'message'])
             && error.category in ['permission', 'network', 'verification', 'whatsapp', 'validation', 'unknown']
             && error.code in [
               'permission-denied', 'unavailable', 'network-request-failed',
               'deadline-exceeded', 'verification-failed', 'whatsapp-launch-failed',
               'invalid-argument', 'validation-failed', 'unknown'
             ]
             && error.message is string
             && error.message.size() <= 200;
    }

    function isValidCheckoutAttemptEvent(event) {
      return event is map
             && event.keys().hasOnly(['eventId', 'stage', 'outcome', 'occurredAt', 'error'])
             && event.keys().hasAll(['eventId', 'stage', 'outcome', 'occurredAt'])
             && event.eventId is string
             && event.eventId.size() > 0
             && event.eventId.size() <= 128
             && event.stage in [
               'started', 'details_validated', 'order_saved',
               'order_verified', 'whatsapp_opened', 'completed'
             ]
             && event.outcome in ['success', 'failed']
             && event.occurredAt is timestamp
             && (!event.keys().hasAny(['error']) || isValidCheckoutAttemptError(event.error));
    }

    function isValidCheckoutAttemptClientCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'supportCode', 'clientWriteToken', 'orderId', 'customer', 'delivery',
               'totalAmount', 'items', 'currentStage', 'result', 'resolutionStatus',
               'createdAt', 'updatedAt', 'expiresAt', 'events'
             ])
             && data.keys().hasAll([
               'supportCode', 'clientWriteToken', 'orderId', 'customer', 'delivery',
               'totalAmount', 'items', 'currentStage', 'result', 'resolutionStatus',
               'createdAt', 'updatedAt', 'expiresAt', 'events'
             ])
             && data.clientWriteToken is string
             && data.clientWriteToken.size() == 64
             && data.supportCode is string
             && data.supportCode.matches('^CHK-[A-Z0-9]{6}$')
             && data.orderId is string
             && isValidCheckoutAttemptCustomer(data.customer)
             && isValidCheckoutAttemptDelivery(data.delivery)
             && data.totalAmount is number
             && data.totalAmount >= 0
             && data.totalAmount <= 1000000000
             && isValidCheckoutAttemptItems(data.items)
             && data.currentStage == 'started'
             && data.result == 'in_progress'
             && data.resolutionStatus == 'open'
             && data.createdAt is timestamp
             && data.updatedAt is timestamp
             && data.updatedAt == data.createdAt
             && data.expiresAt is timestamp
             && data.expiresAt > request.time
             && data.expiresAt <= request.time + duration.value(181, 'd')
             && data.events is list
             && data.events.size() <= 100
             && data.events.size() == 1
             && isValidCheckoutAttemptEvent(data.events[0])
             && data.events[0].stage == 'started'
             && data.events[0].outcome == 'success';
    }

    function isValidCheckoutAttemptClientUpdate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'supportCode', 'clientWriteToken', 'orderId', 'customer', 'delivery',
               'totalAmount', 'items', 'currentStage', 'result', 'resolutionStatus',
               'createdAt', 'updatedAt', 'expiresAt', 'events',
               'linkedOrderDocumentId', 'linkedOrderId', 'error', 'adminNotes', 'resolvedAt'
             ])
             && data.keys().hasAll([
               'supportCode', 'clientWriteToken', 'orderId', 'customer', 'delivery',
               'totalAmount', 'items', 'currentStage', 'result', 'resolutionStatus',
               'createdAt', 'updatedAt', 'expiresAt', 'events'
             ])
             && data.diff(resource.data).affectedKeys().hasOnly([
               'currentStage', 'result', 'updatedAt', 'events',
               'linkedOrderDocumentId', 'linkedOrderId', 'error'
             ])
             && request.resource.data.clientWriteToken == resource.data.clientWriteToken
             && request.resource.data.supportCode == resource.data.supportCode
             && request.resource.data.orderId == resource.data.orderId
             && request.resource.data.customer == resource.data.customer
             && request.resource.data.delivery == resource.data.delivery
             && request.resource.data.totalAmount == resource.data.totalAmount
             && request.resource.data.items == resource.data.items
             && request.resource.data.createdAt == resource.data.createdAt
             && request.resource.data.expiresAt == resource.data.expiresAt
             && request.resource.data.resolutionStatus == resource.data.resolutionStatus
             && request.resource.data.get('adminNotes', null) == resource.data.get('adminNotes', null)
             && request.resource.data.get('resolvedAt', null) == resource.data.get('resolvedAt', null)
             && data.currentStage in [
               'started', 'details_validated', 'order_saved',
               'order_verified', 'whatsapp_opened', 'completed'
             ]
             && data.result in ['in_progress', 'successful', 'failed']
             && isValidCheckoutAttemptCustomer(data.customer)
             && isValidCheckoutAttemptDelivery(data.delivery)
             && data.totalAmount is number
             && data.totalAmount >= 0
             && data.totalAmount <= 1000000000
             && isValidCheckoutAttemptItems(data.items)
             && data.updatedAt is timestamp
             && data.events is list
             && data.events.size() <= 100
             && (
               data.events == resource.data.events
               || (
                 data.events.size() == resource.data.events.size() + 1
                 && data.events == resource.data.events.concat([data.events[data.events.size() - 1]])
                 && isValidCheckoutAttemptEvent(data.events[data.events.size() - 1])
               )
             )
             && (!data.keys().hasAny(['linkedOrderDocumentId']) || data.linkedOrderDocumentId is string)
             && (!data.keys().hasAny(['linkedOrderId']) || data.linkedOrderId is string)
             && (!data.keys().hasAny(['error']) || isValidCheckoutAttemptError(data.error));
    }

    // Products: public read of available items, only admin write
    match /products/{productId} {
      allow read: if (resource.data.available == true) || isAdmin();
      allow write: if isAdmin();
    }

    // Limited-sale items: same pattern as products
    match /limited/{limitedId} {
      allow read: if (resource.data.available == true) || isAdmin();
      allow write: if isAdmin();
    }

    // Counter doc used for limited IDs
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // Users and subcollections
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;

      match /cart/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      match /wishlist/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      match /profile/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Site settings: public read so unauthenticated pages (e.g. popups) load correctly
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promo codes: public read for checkout validation, admin write
    match /promoCodes/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow create: if true;

      // Anyone with the unique order link can view a single order.
      // Listing all orders (e.g. admin dashboard) stays restricted.
      allow get: if true;
      allow list: if isAdmin()
        || (isSignedIn()
            && resource.data.customer.userId != null
            && resource.data.customer.userId == request.auth.uid);

      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.customer.userId != null
            && resource.data.customer.userId == request.auth.uid);

      // Preserve issued order links. Archiving is an update, never a client delete.
      allow delete: if false;
    }

    // Short-lived checkout diagnostics: clients may create and advance only their own snapshot.
    match /checkoutAttempts/{attemptId} {
      allow get, list: if isAdmin();
      allow create: if request.resource.data.clientWriteToken is string
        && isValidCheckoutAttemptClientCreate();
      allow update: if isAdmin() || isValidCheckoutAttemptClientUpdate();
      allow delete: if false;
    }

    // Admin fallback for unprotected collections only. Overlapping matches are ORed.
    match /{collection}/{document=**} {
      allow read, write: if isAdmin()
        && collection != 'orders'
        && collection != 'checkoutAttempts';
    }
  }
}
