{
  "name": "rosary-plant-care",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "catalog": "node scripts/build-species-catalog.mjs",
    "dev": "npm run catalog && vite",
    "preview": "vite preview",
    "prebuild": "npm run catalog",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:catalog": "node --test scripts/build-species-catalog.test.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "android:sync": "powershell -ExecutionPolicy Bypass -File scripts/android-build.ps1 -Mode sync",
    "android:debug": "powershell -ExecutionPolicy Bypass -File scripts/android-build.ps1 -Mode debug"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fraunces": "^5.2.8",
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "firebase": "^12.16.0",
    "idb": "^8.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
