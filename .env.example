# Firebase Configuration
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# The same public config initializes a named secondary checkout-diagnostic Auth
# app. Enable the Anonymous sign-in provider in Firebase Console before deploy.
# No diagnostic writer ID token belongs in this file or any VITE_ variable.

# Optional local file path for SEO artifact builds only. The Vercel checkout API
# does not read FIREBASE_SERVICE_ACCOUNT_PATH.
FIREBASE_SERVICE_ACCOUNT_PATH=C:/path/to/firebase-service-account.json

# Server-only Firebase Admin credentials used by /api/checkout-attempts and also
# supported by SEO artifact builds. Configure exactly one on Vercel. Never use a
# VITE_ prefix and never commit a real value.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Recommended for Vercel: base64-encode the service account JSON into one line.
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json
