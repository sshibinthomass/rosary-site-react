rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email in ['sshibinthomass@gmail.com', 'rosaryplanthouse@gmail.com'];
    }

    function isValidCheckoutAttemptError(error) {
      return error is map
             && error.keys().hasOnly(['category', 'code', 'message'])
             && error.keys().hasAll(['category', 'code', 'message'])
             && error.category in ['permission', 'network', 'verification', 'whatsapp', 'validation', 'unknown']
             && error.code in [
               'permission-denied', 'unavailable', 'network-request-failed',
               'deadline-exceeded', 'verification-failed', 'whatsapp-launch-failed',
               'invalid-argument', 'validation-failed', 'unknown'
             ]
             && error.message is string
             && error.message.size() <= 200;
    }

    function isValidCheckoutAttemptEvent(event) {
      return event is map
             && event.keys().hasOnly(['eventId', 'stage', 'outcome', 'occurredAt', 'error'])
             && event.keys().hasAll(['eventId', 'stage', 'outcome', 'occurredAt'])
             && event.eventId is string
             && event.eventId.size() > 0
             && event.eventId.size() <= 128
             && event.stage in [
               'started', 'details_validated', 'order_saved',
               'order_verified', 'whatsapp_opened', 'completed'
             ]
             && event.outcome in ['success', 'failed']
             && event.occurredAt is timestamp
             && (!event.keys().hasAny(['error']) || isValidCheckoutAttemptError(event.error));
    }

    function isValidCheckoutAttemptClientCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'supportCode', 'clientWriteToken', 'orderId', 'customer', 'delivery',
               'totalAmount', 'items', 'currentStage', 'result', 'resolutionStatus',
               'createdAt', 'updatedAt', 'expiresAt', 'events'
             ])
             && data.keys().hasAll([
               'supportCode', 'clientWriteToken', 'orderId', 'customer', 'delivery',
               'totalAmount', 'items', 'currentStage', 'result', 'resolutionStatus',
               'createdAt', 'updatedAt', 'expiresAt', 'events'
             ])
             && data.clientWriteToken is string
             && data.clientWriteToken.size() == 64
             && data.supportCode is string
             && data.supportCode.matches('^CHK-[A-Z0-9]{6}$')
             && data.orderId is string
             && data.customer is map
             && data.delivery is map
             && data.totalAmount is number
             && data.items is list
             && data.currentStage == 'started'
             && data.result == 'in_progress'
             && data.resolutionStatus == 'open'
             && data.createdAt is timestamp
             && data.updatedAt is timestamp
             && data.updatedAt == data.createdAt
             && data.expiresAt is timestamp
             && data.expiresAt > request.time
             && data.expiresAt <= request.time + duration.value(181, 'd')
             && data.events is list
             && data.events.size() == 1
             && isValidCheckoutAttemptEvent(data.events[0])
             && data.events[0].stage == 'started'
             && data.events[0].outcome == 'success';
    }

    function isValidCheckoutAttemptClientUpdate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
               'supportCode', 'clientWriteToken', 'orderId', 'customer', 'delivery',
               'totalAmount', 'items', 'currentStage', 'result', 'resolutionStatus',
               'createdAt', 'updatedAt', 'expiresAt', 'events',
               'linkedOrderDocumentId', 'linkedOrderId', 'error', 'adminNotes', 'resolvedAt'
             ])
             && data.keys().hasAll([
               'supportCode', 'clientWriteToken', 'orderId', 'customer', 'delivery',
               'totalAmount', 'items', 'currentStage', 'result', 'resolutionStatus',
               'createdAt', 'updatedAt', 'expiresAt', 'events'
             ])
             && data.diff(resource.data).affectedKeys().hasOnly([
               'currentStage', 'result', 'updatedAt', 'events',
               'linkedOrderDocumentId', 'linkedOrderId', 'error'
             ])
             && request.resource.data.clientWriteToken == resource.data.clientWriteToken
             && request.resource.data.supportCode == resource.data.supportCode
             && request.resource.data.orderId == resource.data.orderId
             && request.resource.data.customer == resource.data.customer
             && request.resource.data.delivery == resource.data.delivery
             && request.resource.data.totalAmount == resource.data.totalAmount
             && request.resource.data.items == resource.data.items
             && request.resource.data.createdAt == resource.data.createdAt
             && request.resource.data.expiresAt == resource.data.expiresAt
             && request.resource.data.resolutionStatus == resource.data.resolutionStatus
             && request.resource.data.get('adminNotes', null) == resource.data.get('adminNotes', null)
             && request.resource.data.get('resolvedAt', null) == resource.data.get('resolvedAt', null)
             && data.currentStage in [
               'started', 'details_validated', 'order_saved',
               'order_verified', 'whatsapp_opened', 'completed'
             ]
             && data.result in ['in_progress', 'successful', 'failed']
             && data.updatedAt is timestamp
             && data.events is list
             && (
               data.events == resource.data.events
               || (
                 data.events.size() == resource.data.events.size() + 1
                 && data.events == resource.data.events.concat([data.events[data.events.size() - 1]])
                 && isValidCheckoutAttemptEvent(data.events[data.events.size() - 1])
               )
             )
             && (!data.keys().hasAny(['linkedOrderDocumentId']) || data.linkedOrderDocumentId is string)
             && (!data.keys().hasAny(['linkedOrderId']) || data.linkedOrderId is string)
             && (!data.keys().hasAny(['error']) || isValidCheckoutAttemptError(data.error));
    }

    // Products: public read of available items, only admin write
    match /products/{productId} {
      allow read: if (resource.data.available == true) || isAdmin();
      allow write: if isAdmin();
    }

    // Limited-sale items: same pattern as products
    match /limited/{limitedId} {
      allow read: if (resource.data.available == true) || isAdmin();
      allow write: if isAdmin();
    }

    // Counter doc used for limited IDs
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // Users and subcollections
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;

      match /cart/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      match /wishlist/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      match /profile/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Site settings: public read so unauthenticated pages (e.g. popups) load correctly
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promo codes: public read for checkout validation, admin write
    match /promoCodes/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow create: if true;

      // Anyone with the unique order link can view a single order.
      // Listing all orders (e.g. admin dashboard) stays restricted.
      allow get: if true;
      allow list: if isAdmin()
        || (isSignedIn()
            && resource.data.customer.userId != null
            && resource.data.customer.userId == request.auth.uid);

      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.customer.userId != null
            && resource.data.customer.userId == request.auth.uid);

      // Preserve issued order links. Archiving is an update, never a client delete.
      allow delete: if false;
    }

    // Short-lived checkout diagnostics: clients may create and advance only their own snapshot.
    match /checkoutAttempts/{attemptId} {
      allow get, list: if isAdmin();
      allow create: if request.resource.data.clientWriteToken is string
        && isValidCheckoutAttemptClientCreate();
      allow update: if isAdmin() || isValidCheckoutAttemptClientUpdate();
      allow delete: if false;
    }

    // Admin fallback for unprotected collections only. Overlapping matches are ORed.
    match /{collection}/{document=**} {
      allow read, write: if isAdmin()
        && collection != 'orders'
        && collection != 'checkoutAttempts';
    }
  }
}
